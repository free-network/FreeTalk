From 6f738ec2388b50d871cbe052054e07560a354ae4 Mon Sep 17 00:00:00 2001
From: Ian Clarke <sanity@users.noreply.github.com>
Date: Tue, 3 Mar 2026 22:06:23 -0600
Subject: [PATCH 16/69] fix: correct V4 legacy delegate code_hash (remove
 version byte, add missing last byte)

The .reg file format is: byte[0]=version, bytes[1..33]=code_hash, bytes[33..37]=params_len.
The previous V4 entry incorrectly included the version byte (01) as the first byte of the
code_hash and was missing the last byte (65). This caused DelegateKey equality checks to
fail since DelegateKey compares both key AND code_hash fields.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 ui/src/components/app/chat_delegate.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ui/src/components/app/chat_delegate.rs b/ui/src/components/app/chat_delegate.rs
index fb5b4e80..dc720d8e 100644
--- a/ui/src/components/app/chat_delegate.rs
+++ b/ui/src/components/app/chat_delegate.rs
@@ -74,8 +74,8 @@ const LEGACY_DELEGATES: &[([u8; 32], [u8; 32])] = &[
             12, 121, 64, 44, 151, 105, 74, 45, 134, 6, 127, 109, 209,
         ],
         [
-            1, 199, 91, 97, 211, 1, 251, 214, 161, 60, 176, 183, 7, 203, 78, 78, 89, 241, 42, 244,
-            151, 144, 130, 69, 231, 136, 134, 38, 24, 119, 133, 57,
+            199, 91, 97, 211, 1, 251, 214, 161, 60, 176, 183, 7, 203, 78, 78, 89, 241, 42, 244,
+            151, 144, 130, 69, 231, 136, 134, 38, 24, 119, 133, 57, 65,
         ],
     ),
 ];
