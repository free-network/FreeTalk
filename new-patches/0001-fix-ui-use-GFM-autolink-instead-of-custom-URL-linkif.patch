From 42e8ae24d7d9e6fbf2daa55503d3af93a1e100b2 Mon Sep 17 00:00:00 2001
From: Ian Clarke <sanity@users.noreply.github.com>
Date: Mon, 23 Feb 2026 19:42:01 -0600
Subject: [PATCH 01/69] fix(ui): use GFM autolink instead of custom URL
 linkification

URLs inside backtick code spans were being converted to hyperlinks
because the custom auto_linkify_urls() ran before markdown parsing
and had no awareness of code contexts. Replace with the markdown
crate's built-in GFM autolink extension which correctly skips URLs
in code spans and fenced code blocks.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 ui/src/components/conversation.rs | 103 ++----------------------------
 1 file changed, 7 insertions(+), 96 deletions(-)

diff --git a/ui/src/components/conversation.rs b/ui/src/components/conversation.rs
index 735c59f3..941b5c64 100644
--- a/ui/src/components/conversation.rs
+++ b/ui/src/components/conversation.rs
@@ -294,111 +294,22 @@ fn extract_reply_context(
 
 /// Convert message text to HTML with clickable links that open in new tabs.
 ///
-/// This function:
-/// 1. Auto-linkifies plain URLs (http/https) that aren't already in markdown link syntax
-/// 2. Converts markdown to HTML
-/// 3. Adds target="_blank" rel="noopener noreferrer" to all links for security
+/// Uses GFM autolink literals to linkify plain URLs while correctly
+/// skipping URLs inside code spans and other non-text contexts.
 fn message_to_html(text: &str) -> String {
-    // First, auto-linkify plain URLs that aren't already markdown links
-    let linkified = auto_linkify_urls(text);
-
     // Convert single newlines to hard breaks (two spaces + newline)
     // This preserves line breaks in chat messages as users expect
-    let with_hard_breaks = linkified.replace("\n", "  \n");
+    let with_hard_breaks = text.replace("\n", "  \n");
 
-    // Convert markdown to HTML
-    let html = markdown::to_html(&with_hard_breaks);
+    // Convert markdown to HTML using GFM mode, which includes autolink
+    // literals that correctly handle code spans, existing links, etc.
+    let html = markdown::to_html_with_options(&with_hard_breaks, &markdown::Options::gfm())
+        .unwrap_or_else(|_| markdown::to_html(&with_hard_breaks));
 
     // Add target="_blank" and rel="noopener noreferrer" to all links
     make_links_open_in_new_tab(&html)
 }
 
