From ef4757746a36ec21a028ddf7e8532c3a5d38271b Mon Sep 17 00:00:00 2001
From: Ignacio Duart <iduartgomez@gmail.com>
Date: Thu, 12 Mar 2026 18:13:09 +0100
Subject: [PATCH 59/69] build: bump workspace freenet-stdlib to 0.3.2

---
 Cargo.toml                         | 2 +-
 delegates/chat-delegate/Cargo.toml | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 41579f6f..2966c39a 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -49,7 +49,7 @@ river = { path = "cli", package = "river" }
 # Freenet dependencies
 freenet-scaffold = "0.2.2"
 freenet-scaffold-macro = "0.2.2"
-freenet-stdlib = { version = "0.1.40", features = ["contract"] }
+freenet-stdlib = { version = "0.3.2", features = ["contract"] }
 
 [workspace.package]
 version = "0.1.4"
diff --git a/delegates/chat-delegate/Cargo.toml b/delegates/chat-delegate/Cargo.toml
index b407934c..9a3cf494 100644
--- a/delegates/chat-delegate/Cargo.toml
+++ b/delegates/chat-delegate/Cargo.toml
@@ -9,7 +9,7 @@ freenet-main-delegate = []
 
 [dependencies]
 ciborium.workspace = true
-freenet-stdlib = { version = "0.3.2", features = ["contract"] }
+freenet-stdlib.workspace = true
 bs58 = { workspace = true }
 serde = { workspace = true, features = ["derive"] }
 river-core.workspace = true
-- 
2.53.0

