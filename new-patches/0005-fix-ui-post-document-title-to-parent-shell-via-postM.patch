From 6d4eb2825044c7bd5c493bd27ffed8cb04660cd7 Mon Sep 17 00:00:00 2001
From: Ian Clarke <sanity@users.noreply.github.com>
Date: Fri, 27 Feb 2026 10:25:08 -0600
Subject: [PATCH 05/69] fix(ui): post document title to parent shell via
 postMessage (#118)

* fix(ui): post document title to parent shell via postMessage

River runs inside a sandboxed iframe, so document.title only affects
the iframe's internal title, not the browser tab. This adds a
postMessage call to notify the parent shell page whenever the title
changes, so the browser tab shows the room name instead of "Freenet".

Requires freenet/freenet-core matching PR with __freenet_shell__
message handler in the shell bridge.

Fixes #116

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>

* fix(ui): use JSON.stringify for safe title escaping in postMessage

Replace manual backslash/quote escaping with js_sys::JSON::stringify
to properly handle all special characters (newlines, unicode, etc.)
in room names sent via postMessage to the parent shell.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>

---------

Co-authored-by: Claude Opus 4.6 <noreply@anthropic.com>
---
 ui/src/components/app/document_title.rs | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/ui/src/components/app/document_title.rs b/ui/src/components/app/document_title.rs
index 7fc943f1..e03638c8 100644
--- a/ui/src/components/app/document_title.rs
+++ b/ui/src/components/app/document_title.rs
@@ -38,8 +38,17 @@ fn get_visibility_state() -> bool {
 
 /// Set the document title
 fn set_document_title(title: &str) {
-    if let Some(document) = web_sys::window().and_then(|w| w.document()) {
-        document.set_title(title);
+    if let Some(window) = web_sys::window() {
+        if let Some(document) = window.document() {
+            document.set_title(title);
+        }
+        // Notify parent shell page to update browser tab title
+        let safe_title = js_sys::JSON::stringify(&wasm_bindgen::JsValue::from_str(title))
+            .unwrap_or_else(|_| js_sys::JsString::from("\"\""));
+        let _ = js_sys::eval(&format!(
+            r#"try {{ window.parent.postMessage({{"__freenet_shell__":true,"type":"title","title":{}}}, "*") }} catch(e) {{}}"#,
+            safe_title
+        ));
     }
 }
 
