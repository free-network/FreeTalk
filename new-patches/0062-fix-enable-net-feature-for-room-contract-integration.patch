From 05b67dfa15156ccc37c16c19d4f9d48433c7fd0b Mon Sep 17 00:00:00 2001
From: Ignacio Duart <iduartgomez@gmail.com>
Date: Thu, 12 Mar 2026 20:14:48 +0100
Subject: [PATCH 62/69] fix: enable net feature for room-contract integration
 tests

room-contract tests use WebApi which requires the net feature on
freenet-stdlib. Previously this worked via feature unification with
the freenet dev-dep (both resolved to stdlib 0.1.40), but now the
workspace uses 0.3.2 while the freenet dev-dep uses 0.1.40, so
features don't unify across major versions.

Added a net feature flag to room-contract and enabled it in CI.
---
 .github/workflows/build.yml        | 2 +-
 contracts/room-contract/Cargo.toml | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 8855a298..d1c578db 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -74,7 +74,7 @@ jobs:
       env:
         RUST_MIN_STACK: 8388608
         CARGO_TARGET_DIR: ${{ github.workspace }}/target
-      run: cargo test --package room-contract
+      run: cargo test --package room-contract --features net
 
     - name: Test delegate key
       env:
diff --git a/contracts/room-contract/Cargo.toml b/contracts/room-contract/Cargo.toml
index 59933c4c..cbf3ca77 100644
--- a/contracts/room-contract/Cargo.toml
+++ b/contracts/room-contract/Cargo.toml
@@ -27,11 +27,12 @@ freenet-main-contract = []
 trace = ["freenet-stdlib/trace"]
 # Use ed25519-compact for WASM builds to avoid getrandom contamination
 wasm-crypto = ["ed25519-compact"]
+# Enable networking support for integration tests (WebApi)
+net = ["freenet-stdlib/net"]
 
 [dev-dependencies]
 anyhow = "1.0"
 freenet = "0.1.179"
-freenet-stdlib = { workspace = true, features = ["net"] }
 once_cell.workspace = true
 tempfile = "3.0"
 testresult = "0.4"
-- 
