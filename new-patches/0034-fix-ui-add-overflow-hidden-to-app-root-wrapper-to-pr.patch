From 1039e32487af70837bb3c17acd8f70b520b5522e Mon Sep 17 00:00:00 2001
From: Ian Clarke <sanity@users.noreply.github.com>
Date: Sat, 7 Mar 2026 09:36:53 -0600
Subject: [PATCH 34/69] fix(ui): add overflow-hidden to app-root wrapper to
 prevent layout collapse

The mobile responsive changes removed overflow-hidden from the outer
flex-col wrapper, allowing content to overflow the fixed container
and causing sidebars to disappear in some browsers.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 ui/src/components/app.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ui/src/components/app.rs b/ui/src/components/app.rs
index ea3cec74..7740e8d5 100644
--- a/ui/src/components/app.rs
+++ b/ui/src/components/app.rs
@@ -190,7 +190,7 @@ pub fn App() -> Element {
 
         // Outer wrapper: flex-col for mobile header + main content
         // app-root: position:fixed for iOS Safari virtual keyboard fix
-        div { class: "flex flex-col relative app-root",
+        div { class: "flex flex-col overflow-hidden app-root",
 
         // Mobile header bar (hidden on md+)
         div { class: "md:hidden flex items-center justify-between px-3 py-2 bg-panel border-b border-border flex-shrink-0",
-- 
2.53.0

