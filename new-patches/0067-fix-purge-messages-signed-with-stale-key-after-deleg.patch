+pub enum MigrationResult {
+    /// Key already matched in delegate, no changes needed.
+    AlreadyCurrent,
+    /// Stale key was overwritten with current key.
+    StaleKeyOverwritten,
+    /// Key was stored for the first time.
+    Stored,
+    /// Migration failed.
+    Failed,
