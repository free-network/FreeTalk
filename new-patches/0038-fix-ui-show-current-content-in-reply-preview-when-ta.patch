From f4303e642281a4b881dc4d1f1eb455a214c8449a Mon Sep 17 00:00:00 2001
From: Ian Clarke <sanity@users.noreply.github.com>
Date: Sat, 7 Mar 2026 11:57:28 -0600
Subject: [PATCH 38/69] fix(ui): show current content in reply preview when
 target message is edited

When replying to a message, the reply stored a snapshot of the target's
content at reply time. If the target message was later edited, the reply
strip still showed the old pre-edit text. Now looks up the target
message's current effective_text (which respects edits) when rendering.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 ui/src/components/conversation.rs | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/ui/src/components/conversation.rs b/ui/src/components/conversation.rs
index 57fc363d..4dc481ab 100644
--- a/ui/src/components/conversation.rs
+++ b/ui/src/components/conversation.rs
@@ -122,9 +122,26 @@ fn group_messages(
             .unwrap_or_default();
 
         // Extract reply context if this is a reply message
-        let (reply_to_author, reply_to_preview, reply_to_message_id) =
+        let (reply_to_author, mut reply_to_preview, reply_to_message_id) =
             extract_reply_context(&message.message.content, secrets);
 
+        // If the replied-to message has been edited, use its current content
+        if let (Some(ref target_id), Some(_)) = (&reply_to_message_id, &reply_to_preview) {
+            if let Some(target_msg) = messages_state
+                .messages
+                .iter()
+                .find(|m| &m.id() == target_id)
+            {
+                let current_text = messages_state
+                    .effective_text(target_msg)
+                    .unwrap_or_else(|| {
+                        decrypt_message_content(&target_msg.message.content, secrets)
+                    });
+                let preview: String = current_text.chars().take(100).collect();
+                reply_to_preview = Some(preview);
+            }
+        }
+
         // Look up propagation delay (send time → receive time)
         let send_time_ms = raw_time.timestamp_millis();
         let receive_delay_secs = get_delay_secs(&message_id, send_time_ms);
