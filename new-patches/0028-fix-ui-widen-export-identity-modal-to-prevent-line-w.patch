From 614e409ee3cf8a4c7f1500b4fa70af0f3388ce0b Mon Sep 17 00:00:00 2001
From: Ian Clarke <sanity@users.noreply.github.com>
Date: Fri, 6 Mar 2026 13:55:16 -0600
Subject: [PATCH 28/69] fix(ui): widen export identity modal to prevent line
 wrapping

The 64-char armored lines were wrapping in the textarea because
max-w-lg (512px) was too narrow. Changed to max-w-xl (576px).

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 ui/src/components/members.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ui/src/components/members.rs b/ui/src/components/members.rs
index 6e971462..97cff34d 100644
--- a/ui/src/components/members.rs
+++ b/ui/src/components/members.rs
@@ -397,7 +397,7 @@ fn ExportIdentityModal(is_active: Signal<bool>) -> Element {
                 token_text.set(String::new());
             },
             div {
-                class: "bg-panel border border-border rounded-xl shadow-lg p-6 max-w-lg w-full mx-4",
+                class: "bg-panel border border-border rounded-xl shadow-lg p-6 max-w-xl w-full mx-4",
                 onclick: move |e| e.stop_propagation(),
                 h3 { class: "text-lg font-semibold text-text mb-4",
                     "Export Identity"
-- 
