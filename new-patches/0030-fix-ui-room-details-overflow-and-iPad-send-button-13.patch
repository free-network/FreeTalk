From 8afdda8f10da38f8e78dee2d6108603c1bc27a47 Mon Sep 17 00:00:00 2001
From: Ian Clarke <sanity@users.noreply.github.com>
Date: Fri, 6 Mar 2026 14:32:39 -0600
Subject: [PATCH 30/69] fix(ui): room details overflow and iPad send button
 (#135)

- Add max-h-[90vh] + overflow-y-auto to room details modal so it
  scrolls when content exceeds viewport height
- Wrap message input in a <form> with onsubmit so iPad virtual
  keyboard "Return" key and Send button work via form submission.
  Mark Send as type="submit" and emoji button as type="button".

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 ui/src/components/conversation/message_input.rs | 12 ++++++++----
 ui/src/components/room_list/edit_room_modal.rs  |  2 +-
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/ui/src/components/conversation/message_input.rs b/ui/src/components/conversation/message_input.rs
index 2288923e..ea09c57e 100644
--- a/ui/src/components/conversation/message_input.rs
+++ b/ui/src/components/conversation/message_input.rs
@@ -89,10 +89,16 @@ pub fn MessageInput(
                         rsx! {}
                     }
                 }
-                div { class: "flex gap-3 items-end",
+                form {
+                    class: "flex gap-3 items-end",
+                    onsubmit: move |evt| {
+                        evt.prevent_default();
+                        send_message();
+                    },
                     // Emoji picker button and popup
                     div { class: "relative self-center",
                         button {
+                            r#type: "button",
                             class: "p-2.5 rounded-xl hover:bg-surface transition-colors",
                             title: "Insert emoji",
                             onclick: move |_| show_emoji_picker.set(!show_emoji_picker()),
@@ -139,10 +145,8 @@ pub fn MessageInput(
                         }
                     }
                     button {
+                        r#type: "submit",
                         class: "px-5 py-2.5 bg-accent hover:bg-accent-hover text-white font-medium rounded-xl transition-colors disabled:opacity-50 disabled:cursor-not-allowed",
-                        onclick: move |_| {
-                            send_message();
-                        },
                         "Send"
                     }
                 }
diff --git a/ui/src/components/room_list/edit_room_modal.rs b/ui/src/components/room_list/edit_room_modal.rs
index 3f940757..590f9cc0 100644
--- a/ui/src/components/room_list/edit_room_modal.rs
+++ b/ui/src/components/room_list/edit_room_modal.rs
@@ -63,7 +63,7 @@ pub fn EditRoomModal() -> Element {
                 }
                 // Modal content
                 div {
-                    class: "relative z-10 w-full max-w-md mx-4 bg-panel rounded-xl shadow-xl border border-border",
+                    class: "relative z-10 w-full max-w-md mx-4 bg-panel rounded-xl shadow-xl border border-border max-h-[90vh] overflow-y-auto",
                     div {
                         class: "p-6",
                         h1 { class: "text-xl font-semibold text-text mb-4", "Room Details" }
-- 
2.53.0

