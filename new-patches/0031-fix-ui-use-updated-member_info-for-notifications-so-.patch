From 90ebbaac2e63f18390c298638053070c1a158bc4 Mon Sep 17 00:00:00 2001
From: Ian Clarke <sanity@users.noreply.github.com>
Date: Fri, 6 Mar 2026 19:48:44 -0600
Subject: [PATCH 31/69] fix(ui): use updated member_info for notifications so
 sender name is correct

The notification system was capturing member_info BEFORE applying the
state delta, so when a new member sent a message (with their member_info
included in the same delta), the notification would show "Someone"
instead of their actual nickname. Fix both code paths (apply_delta and
update_room_state) to use member_info from the updated state.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 ui/assets/tailwind.css                        | 24 +++++++++++++++++++
 ui/src/components/app.rs                      |  2 +-
 .../app/freenet_api/room_synchronizer.rs      | 18 ++++++++++----
 .../components/conversation/message_input.rs  |  9 +++++--
 4 files changed, 45 insertions(+), 8 deletions(-)

diff --git a/ui/assets/tailwind.css b/ui/assets/tailwind.css
index 7f4d82fc..956b9793 100644
--- a/ui/assets/tailwind.css
+++ b/ui/assets/tailwind.css
@@ -144,6 +144,30 @@ html, body {
   color: rgba(0, 0, 0, 0.8);
 }
 
+/* iOS Safari viewport and touch fixes */
+
+/* Use fixed positioning for the app root to prevent iOS Safari's
+   virtual keyboard from desynchronizing touch coordinates.
+   When iOS shows the keyboard, it visually scrolls the page but
+   100vh doesn't change, causing overflow-hidden containers to have
+   "dead" touch zones. Fixed positioning anchors to the visual viewport. */
+.app-root {
+  position: fixed;
+  inset: 0;
+}
+
+/* Disable 300ms tap delay on all interactive elements.
+   iOS Safari delays click events to detect double-tap-to-zoom;
+   touch-action: manipulation disables this for faster response. */
+button, a, input, textarea, select, [role="button"] {
+  touch-action: manipulation;
+}
+
+/* Ensure smooth momentum scrolling on iOS for scrollable containers */
+.overflow-y-auto, .overflow-auto {
+  -webkit-overflow-scrolling: touch;
+}
+
 /* Scrollbar styling */
 ::-webkit-scrollbar {
   width: 8px;
