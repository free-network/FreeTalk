+                        // tapping a submit button while the keyboard is visible causes
+                        // the keyboard to dismiss first, which triggers a viewport resize
+                        // that cancels the click→submit event chain.
+                        onclick: move |_| send_message(),
                         "Send"
                     }
                 }
