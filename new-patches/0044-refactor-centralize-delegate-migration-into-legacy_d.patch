+        .map(|i| u8::from_str_radix(&hex[i..i + 2], 16).unwrap())
+        .collect();
+    if bytes.len() != 32 {
+        panic!(
+            "{} {} has {} bytes, expected 32",
+            version,
+            field,
+            bytes.len()
+        );
+    }
+    let mut arr = [0u8; 32];
+    arr.copy_from_slice(&bytes);
